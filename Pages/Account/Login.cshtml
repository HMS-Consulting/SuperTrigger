@page
@model SuperTrigger.Web.Pages.Account.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SuperTrigger – Login</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:400,500&display=swap" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Roboto', sans-serif; background: #f5f5f5; display: flex; align-items: center; justify-content: center; height: 100vh; }
        .card { background: white; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.15); padding: 40px 36px; width: 380px; }
        h1 { font-size: 1.4rem; font-weight: 500; color: #1976d2; margin-bottom: 8px; }
        .subtitle { color: #757575; font-size: 0.875rem; margin-bottom: 28px; }
        .field { margin-bottom: 16px; }
        label { display: block; font-size: 0.75rem; color: #616161; margin-bottom: 4px; }
        input[type=text], input[type=password] {
            width: 100%; padding: 10px 12px; border: 1px solid #bdbdbd; border-radius: 4px;
            font-size: 0.95rem; outline: none; transition: border 0.2s;
        }
        input:focus { border-color: #1976d2; }
        .btn-primary {
            width: 100%; padding: 11px; background: #1976d2; color: white; border: none;
            border-radius: 4px; font-size: 1rem; cursor: pointer; margin-top: 8px; font-family: inherit;
        }
        .btn-primary:hover { background: #1565c0; }
        .btn-windows {
            width: 100%; padding: 11px; background: white; color: #424242; border: 1px solid #bdbdbd;
            border-radius: 4px; font-size: 0.95rem; cursor: pointer; margin-top: 10px; font-family: inherit;
        }
        .btn-windows:hover { background: #f5f5f5; }
        .divider { display: flex; align-items: center; gap: 12px; color: #9e9e9e; font-size: 0.8rem; margin: 20px 0 16px; }
        .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: #e0e0e0; }
        .error { color: #c62828; font-size: 0.82rem; margin-top: -8px; margin-bottom: 12px; }
    </style>
</head>
<body>
<div class="card">
    <h1>SuperTrigger</h1>
    <p class="subtitle">Sign in to continue</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="error">@Model.ErrorMessage</p>
    }

    <form method="post">
        <div asp-validation-summary="All" class="error"></div>
        <div class="field">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" autocomplete="username" required />
        </div>
        <div class="field">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" autocomplete="current-password" required />
        </div>
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <button type="submit" class="btn-primary">Sign in</button>
    </form>

    <div class="divider">or</div>

    <button type="button" class="btn-windows" onclick="windowsLogin()">
        Sign in with Windows (AD)
    </button>
    <p id="win-error" style="color:#c62828;font-size:0.8rem;margin-top:8px;display:none;">
        Automatic sign-in failed. Enter your domain username and password above.
    </p>
    <p style="color:#9e9e9e;font-size:0.75rem;margin-top:6px;text-align:center;">
        AD users can also type their domain username and password directly above.
    </p>

    <script>
    function windowsLogin() {
        var returnUrl = '@Html.Raw(Uri.EscapeDataString(Model.ReturnUrl ?? "/"))';
        fetch('/account/windows-login-probe?returnUrl=' + returnUrl, {
            method: 'GET',
            credentials: 'include'
        }).then(function(r) {
            if (r.ok) {
                r.json().then(function(d) { window.location = d.redirect || '/'; });
            } else {
                document.getElementById('win-error').style.display = 'block';
            }
        }).catch(function() {
            document.getElementById('win-error').style.display = 'block';
        });
    }
    </script>
</div>
</body>
</html>
