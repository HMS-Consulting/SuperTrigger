<?xml version="1.0" encoding="utf-8" ?>
<!--
  ╔══════════════════════════════════════════════════════════════════╗
  ║  SuperTrigger.Web — NLog Logging Configuration                  ║
  ║                                                                  ║
  ║  This file controls where and how logs are written.              ║
  ║  Changes are applied AUTOMATICALLY — no restart needed.          ║
  ║                                                                  ║
  ║  Levels (lowest → highest):                                      ║
  ║    Trace · Debug · Info · Warn · Error · Fatal                   ║
  ║                                                                  ║
  ║  To activate a target:                                           ║
  ║    1. Uncomment the <target> block (if it is commented out)      ║
  ║    2. Uncomment the matching <logger> rule at the bottom         ║
  ║                                                                  ║
  ║  Full documentation: https://nlog-project.org/config/            ║
  ╚══════════════════════════════════════════════════════════════════╝
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Warn"
      internalLogFile="${specialfolder:CommonApplicationData}/HMS/SuperTriggerWeb/nlog-internal.log">

  <targets>

    <!-- ═══════════════════════════════════════════════════════════
         TARGET 1 · PLAIN-TEXT FILE  [ACTIVE]
         Daily rotation · 30-day archive
         Location: %ProgramData%\HMS\SuperTriggerWeb\
         ═══════════════════════════════════════════════════════════ -->
    <target name="file-text"
            xsi:type="File"
            fileName="${specialfolder:CommonApplicationData}/HMS/SuperTriggerWeb/${shortdate}_Web.log"
            layout="${longdate}|${level:uppercase=true}|${logger:shortName=true}|${message}${exception:format=tostring}"
            archiveEvery="Day"
            archiveNumbering="Date"
            archiveDateFormat="yyyy-MM-dd"
            maxArchiveFiles="30"
            keepFileOpen="false"
            encoding="utf-8" />

    <!-- ═══════════════════════════════════════════════════════════
         TARGET 2 · JSON FILE  [INACTIVE — uncomment rule to enable]
         Structured NDJSON (one JSON object per line).
         Ideal for ingestion by Logstash, Filebeat, or any log shipper.
         ═══════════════════════════════════════════════════════════ -->
    <target name="file-json"
            xsi:type="File"
            fileName="${specialfolder:CommonApplicationData}/HMS/SuperTriggerWeb/${shortdate}_Web.json"
            archiveEvery="Day"
            archiveNumbering="Date"
            archiveDateFormat="yyyy-MM-dd"
            maxArchiveFiles="30"
            keepFileOpen="false"
            encoding="utf-8">
      <layout xsi:type="JsonLayout" includeEventProperties="true" renderEmptyObject="false">
        <attribute name="time"      layout="${longdate}" />
        <attribute name="level"     layout="${level:uppercase=true}" />
        <attribute name="logger"    layout="${logger:shortName=true}" />
        <attribute name="message"   layout="${message}" />
        <attribute name="exception" layout="${exception:format=tostring}" encode="false" />
      </layout>
    </target>

    <!-- ═══════════════════════════════════════════════════════════
         TARGET 3 · CONSOLE  [ACTIVE in dev, optional in production]
         ═══════════════════════════════════════════════════════════ -->
    <target name="console"
            xsi:type="ColoredConsole"
            layout="${longdate}|${level:uppercase=true}|${logger:shortName=true}|${message}${exception:format=Message}">
      <highlight-row condition="level == LogLevel.Warn"  foregroundColor="Yellow" />
      <highlight-row condition="level == LogLevel.Error" foregroundColor="Red" />
      <highlight-row condition="level == LogLevel.Fatal" foregroundColor="Red" backgroundColor="White" />
    </target>

    <!-- ═══════════════════════════════════════════════════════════
         TARGET 4 · WINDOWS EVENT LOG  [INACTIVE]
         ───────────────────────────────────────────────────────────
         SETUP (run once as Administrator in PowerShell):
           New-EventLog -Source "SuperTrigger" -LogName Application
         ═══════════════════════════════════════════════════════════ -->
    <target name="eventlog"
            xsi:type="EventLog"
            source="SuperTrigger"
            log="Application"
            layout="${message}${newline}${exception:format=tostring}" />

    <!-- ═══════════════════════════════════════════════════════════
         TARGET 5 · SQL DATABASE  [INACTIVE]
         ───────────────────────────────────────────────────────────
         Built into NLog — works with any ADO.NET provider.
         Install the provider NuGet package first, e.g.:
           dotnet add package Microsoft.Data.SqlClient
         Then update the connectionString below.

         SQL to create the target table:
           CREATE TABLE SuperTriggerLogs (
             Id        INT IDENTITY PRIMARY KEY,
             Timestamp DATETIME2 NOT NULL,
             Level     NVARCHAR(10),
             Logger    NVARCHAR(256),
             Message   NVARCHAR(MAX),
             Exception NVARCHAR(MAX)
           );
         ═══════════════════════════════════════════════════════════ -->
    <!--
    <target name="database"
            xsi:type="Database"
            dbProvider="Microsoft.Data.SqlClient.SqlConnection, Microsoft.Data.SqlClient"
            connectionString="Server=YOUR_SERVER;Database=Logs;Integrated Security=true;TrustServerCertificate=true">
      <commandText>
        INSERT INTO SuperTriggerLogs (Timestamp, Level, Logger, Message, Exception)
        VALUES (@ts, @level, @logger, @msg, @ex)
      </commandText>
      <parameter name="@ts"     layout="${longdate}" dbType="DbType.DateTime2" />
      <parameter name="@level"  layout="${level}" />
      <parameter name="@logger" layout="${logger:shortName=true}" />
      <parameter name="@msg"    layout="${message}" />
      <parameter name="@ex"     layout="${exception:format=tostring}" />
    </target>
    -->

    <!-- ═══════════════════════════════════════════════════════════
         TARGET 6 · ELASTICSEARCH  [INACTIVE]
         ───────────────────────────────────────────────────────────
         Requires NuGet package:
           dotnet add package NLog.Targets.ElasticSearch
         https://github.com/ReactiveMarkets/NLog.Targets.ElasticSearch
         ═══════════════════════════════════════════════════════════ -->
    <!--
    <extensions>
      <add assembly="NLog.Targets.ElasticSearch" />
    </extensions>

    <target name="elastic"
            xsi:type="BufferingWrapper"
            flushTimeout="5000"
            bufferSize="100">
      <target xsi:type="ElasticSearch"
              uri="http://YOUR_ELASTIC_HOST:9200"
              index="supertrigger-${date:format=yyyy.MM}"
              requireAuth="false"
              username=""
              password="">
        <field name="level"     layout="${level}" />
        <field name="logger"    layout="${logger:shortName=true}" />
        <field name="message"   layout="${message}" />
        <field name="exception" layout="${exception:format=tostring}" />
        <field name="host"      layout="${machinename}" />
      </target>
    </target>
    -->

    <!-- ═══════════════════════════════════════════════════════════
         TARGET 7 · HTTP / WEBHOOK  [INACTIVE]
         ───────────────────────────────────────────────────────────
         Posts structured JSON to any HTTP endpoint.
         Compatible with Splunk HEC, Grafana Loki push API,
         custom webhooks, Azure Monitor, etc.
         Requires NuGet package:
           dotnet add package NLog.Targets.Http
         https://github.com/NickAc/NLog.Targets.Http
         ═══════════════════════════════════════════════════════════ -->
    <!--
    <extensions>
      <add assembly="NLog.Targets.Http" />
    </extensions>

    <target name="webhook"
            xsi:type="HTTP"
            url="https://YOUR_ENDPOINT/log"
            method="POST"
            contentType="application/json"
            ignoreSslErrors="false">
      <layout xsi:type="JsonLayout">
        <attribute name="time"    layout="${longdate}" />
        <attribute name="level"   layout="${level:uppercase=true}" />
        <attribute name="logger"  layout="${logger:shortName=true}" />
        <attribute name="message" layout="${message}" />
        <attribute name="host"    layout="${machinename}" />
      </layout>
    </target>
    -->

    <!-- ═══════════════════════════════════════════════════════════
         TARGET 8 · SEQ  [INACTIVE]
         ───────────────────────────────────────────────────────────
         Requires NuGet package:
           dotnet add package NLog.Targets.Seq
         https://github.com/datalust/nlog-targets-seq
         ═══════════════════════════════════════════════════════════ -->
    <!--
    <extensions>
      <add assembly="NLog.Targets.Seq" />
    </extensions>

    <target name="seq"
            xsi:type="BufferingWrapper"
            bufferSize="1000"
            flushTimeout="2000">
      <target xsi:type="Seq"
              serverUrl="http://YOUR_SEQ_HOST:5341"
              apiKey="" />
    </target>
    -->

  </targets>

  <!-- ╔══════════════════════════════════════════════════════════════╗
       ║  RULES                                                       ║
       ║  Evaluated top-to-bottom. first matching rule wins unless    ║
       ║  final="false" is set (rule continues to next match).        ║
       ║  writeTo="" with final="false" = suppress without stopping.  ║
       ╚══════════════════════════════════════════════════════════════╝ -->
  <rules>

    <!-- Suppress noisy ASP.NET / EF Core framework loggers -->
    <logger name="Microsoft.AspNetCore.*"             maxLevel="Info" writeTo="" final="true" />
    <logger name="Microsoft.EntityFrameworkCore.*"    maxLevel="Info" writeTo="" final="true" />
    <logger name="System.Net.Http.*"                  maxLevel="Info" writeTo="" final="true" />

    <!-- ── ACTIVE TARGETS ─────────────────────────────────────── -->

    <logger name="*" minLevel="Info" writeTo="file-text" />
    <logger name="*" minLevel="Info" writeTo="console" />

    <!-- ── INACTIVE TARGETS (uncomment to activate) ──────────── -->

    <!-- JSON file — structured logging for log shippers -->
    <!-- <logger name="*" minLevel="Info" writeTo="file-json" /> -->

    <!-- Windows Event Log — Warn and above only -->
    <!-- <logger name="*" minLevel="Warn" writeTo="eventlog" /> -->

    <!-- SQL Database -->
    <!-- <logger name="*" minLevel="Info" writeTo="database" /> -->

    <!-- Elasticsearch -->
    <!-- <logger name="*" minLevel="Info" writeTo="elastic" /> -->

    <!-- HTTP / Webhook -->
    <!-- <logger name="*" minLevel="Info" writeTo="webhook" /> -->

    <!-- Seq -->
    <!-- <logger name="*" minLevel="Info" writeTo="seq" /> -->

  </rules>

</nlog>
