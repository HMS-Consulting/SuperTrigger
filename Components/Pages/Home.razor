@page "/"
@attribute [Authorize]
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Dashboard - SuperTrigger</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Dashboard</MudText>

<MudGrid>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex align-center gap-4">
            <MudIcon Icon="@Icons.Material.Filled.Folder" Color="Color.Primary" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.h4">@_fileTriggerCount</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Active File Triggers</MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex align-center gap-4">
            <MudIcon Icon="@Icons.Material.Filled.Email" Color="Color.Secondary" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.h4">@_mailTriggerCount</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Active Mail Triggers</MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex align-center gap-4">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.h4">@_successCount</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Items Today (Success)</MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex align-center gap-4">
            <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.h4">@_errorCount</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Items Today (Failed)</MudText>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudText Typo="Typo.h6" Class="mt-6 mb-3">Recent Activity</MudText>
<MudTable Items="_recentLogs" Dense="true" Hover="true" Striped="true">
    <HeaderContent>
        <MudTh>Time</MudTh>
        <MudTh>Trigger</MudTh>
        <MudTh>Type</MudTh>
        <MudTh>Queue</MudTh>
        <MudTh>Status</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.CreatedAt.ToString("dd/MM HH:mm:ss")</MudTd>
        <MudTd>@context.TriggerName</MudTd>
        <MudTd>@context.TriggerType</MudTd>
        <MudTd>@context.QueueName</MudTd>
        <MudTd>
            @if (context.Success)
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small">OK</MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Error" Size="Size.Small" Title="@context.ErrorMessage">FAIL</MudChip>
            }
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private int _fileTriggerCount;
    private int _mailTriggerCount;
    private int _successCount;
    private int _errorCount;
    private List<QueueItemLog> _recentLogs = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _fileTriggerCount = await db.FileTriggers.CountAsync(t => t.Active);
        _mailTriggerCount = await db.MailTriggers.CountAsync(t => t.Active);

        var today = DateTime.Today;
        _successCount = await db.QueueItemLogs.CountAsync(l => l.CreatedAt >= today && l.Success);
        _errorCount = await db.QueueItemLogs.CountAsync(l => l.CreatedAt >= today && !l.Success);

        _recentLogs = await db.QueueItemLogs
            .OrderByDescending(l => l.CreatedAt)
            .Take(20)
            .ToListAsync();
    }
}
