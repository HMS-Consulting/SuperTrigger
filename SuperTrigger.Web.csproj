<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Keep in sync with CreateMSI\Product.wxs Product/@Version on every release; shown on the About page. -->
    <Version>26.8.31</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SuperTrigger.Web</RootNamespace>
    <AssemblyName>SuperTrigger.Web</AssemblyName>
    <!-- CreateMSI\ is the WiX installer project that lives inside this folder. Its publish\ staging
         directory holds a full copy of this app's own output, so it must stay out of the SDK's
         default Content globs (**/*.json, **/*.config) - otherwise every build would fold the
         previous build's output back into the next one. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);CreateMSI\**;CustomActions.Web\**</DefaultItemExcludes>
    <!-- No UseWindowsForms/UseWpf here on purpose: this is a headless IIS-hosted web app and uses no
         WinForms/WPF API. Either flag adds a Microsoft.WindowsDesktop.App framework reference to
         SuperTrigger.Web.runtimeconfig.json, which the ASP.NET Core Hosting Bundle does NOT install,
         and the app then dies at startup with apphost exit code 0x80008096 (FrameworkMissingFailure). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="7.14.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.6" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="8.0.0" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="5.3.14" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.60.3" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="CredentialManagement" Version="1.0.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Exchange.WebServices">
      <HintPath>CustomDLLs\Microsoft.Exchange.WebServices.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Update="nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
